<div class='scene-form' data-controller='scene-layer'>
  <div class='scene-preview' data-scene-layer-target='previewHolder'>
    <% @scene.layers.each_with_index do |layer, index| %>
      <% if layer.asset.content_type.include?('video') %>
        <div class='scene-preview--layer' data-index='<%= index %>' data-scene-layer-target='preview'>
          <video src="<%= layer.asset.url %>" muted loop autoplay>
        </div>
      <% else %>
        <div class='scene-preview--layer' data-index='<%= index %>' 
             style="background-image: url('<%= layer.asset.url %>'); background-size: cover" 
             data-scene-layer-target='preview'></div>
      <% end %>
    <% end %>
  </div>

  <%= simple_form_for @scene, url: @scene.new_record? ? scenes_path : scene_path(@scene), html: { class: "scene-options"} do |f| %>
    <%= f.input :title %>
    <%= f.input :slug %>
    <hr />
    <div class='links'>
      Layers <%= link_to_add_association '+', f, :layers, "data-association-insertion-node": '.scene-layers', "data-association-insertion-method": 'append', class: "btn" %>
    </div>
    <div class='scene-layers' >
      <%= f.simple_fields_for :layers do |layer| %>
        <%= render 'layer_fields', f: layer %>
      <% end %>
    </div>
    <%= f.submit class: 'btn' %>
  <% end %>
</div>