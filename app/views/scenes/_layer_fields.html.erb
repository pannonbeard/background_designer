<div class='nested-fields layer-fields' data-layerid='<%= f.object.id %>' data-scene-layer-target='layer' data-index='<%= f.index %>'>
  <div class='shift-stack'>
    <div class='shift-up' data-action='click->scene-layer#shiftUp'><span class="material-symbols-outlined">arrow_upward</span></div>
    <div class='shift-down' data-action='click->scene-layer#shiftDown'><span class="material-symbols-outlined">arrow_downward</span></div>
  </div>
  <% if f.object.id %>
    <p><%= truncate(f.object.asset.filename.to_s) %></p>
  <% else%>
    <%= f.input :asset,  label: 'Add Asset', input_html: { data: { 'scene-layer-target': 'input' } }%>
  <% end %>
  <%= f.input :stack, as: :hidden, input_class: 'stack' %>

  <%= link_to_remove_association f, class: 'btn' do %>
    <span class="material-symbols-outlined">close</span>
  <% end %>
</div>