<!DOCTYPE html>
<html>
  <head>
    <title>BackgroundDesigner</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <% unless authenticated? %>
    <body>
      <%= render 'layouts/login' %>
    </body>
  <% else %>
    <body class="grid 
      [grid-template-areas:'aside_header'_'aside_main'] 
      grid-cols-[auto_1fr] 
      grid-rows-[auto_1fr]
      min-h-screen
      p-0
      m-0
    ">
      <aside class='[grid-area:aside] bg-blue-600 w-[250px]'>
        <h1 class='text-xl font-bold text-white text-center p-4'>BG Scene Switcher</h1>
        <nav>
          <%= link_to "Home", root_path, class: 'block w-full px-4 py-2 hover:bg-blue-500 text-white' %>
        </nav>
      </aside>
      <header class='[grid-area:header] bg-blue-200 flex items-center justify-end px-4'>
        <nav>
          <% if authenticated? %>
            <%= button_to 'Sign Out', session_path, method: :delete %>
          <% end %>
        </nav>
      </header>
      <main class="[grid-area:main] p-2">
        <%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
        <%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

        <%= yield %>
      </main>
    </body>
  <% end %>
</html>
